{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCP Chat - tauri版v0.1.0",
  "version": "0.1.0",
  "identifier": "com.vcp.newchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VCP Chat - tauri版v0.1.0",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "devtools": false,
        "visible": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src", "script-src", "img-src"],
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: tauri: asset: http: https:; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src * tauri: asset: http: https: ws: wss:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:path:allow-resolve-directory",
            "core:path:default",
            "fs:allow-appdata-write",
            "fs:allow-appdata-write-recursive",
            "fs:allow-appdata-read",
            "fs:allow-appdata-read-recursive",
            "fs:allow-applog-write",
            "fs:allow-applog-write-recursive",
            "fs:allow-applog-read",
            "fs:allow-applog-read-recursive",
            "fs:allow-write-text-file",
            "fs:allow-read-text-file",
            "fs:allow-create",
            "fs:allow-mkdir"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**", "$APPLOG/**"],
        "deny": []
      }
    }
  }
}
