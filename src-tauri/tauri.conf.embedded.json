{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VCP Chat - tauri版v0.1.0 (内置WebView2)",
  "version": "0.1.0",
  "identifier": "com.vcp.newchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VCP Chat - tauri版v0.1.0 (内置WebView2)",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "devtools": true,
        "visible": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src", "script-src", "img-src"],
      "csp": "default-src 'self' tauri: asset: https://asset.localhost http://ipc.localhost ipc:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' asset: https://asset.localhost http://asset.localhost; img-src 'self' data: asset: https://asset.localhost http://asset.localhost tauri:; font-src 'self' data:; connect-src 'self' tauri: asset: https://asset.localhost http://ipc.localhost ipc:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-emit",
            "core:path:allow-resolve-directory",
            "core:path:default",
            "fs:allow-appdata-write",
            "fs:allow-appdata-write-recursive",
            "fs:allow-appdata-read",
            "fs:allow-appdata-read-recursive",
            "fs:allow-applog-write",
            "fs:allow-applog-write-recursive",
            "fs:allow-applog-read",
            "fs:allow-applog-read-recursive",
            "fs:allow-write-text-file",
            "fs:allow-read-text-file",
            "fs:allow-create",
            "fs:allow-mkdir"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": ["$APPDATA/**", "$APPLOG/**"],
        "deny": []
      }
    }
  }
}
